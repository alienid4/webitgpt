# webitgpt offline install config
#
# Copy this file to install.env and adjust values before running install_offline.sh.
# The installer does not import home/lab test data unless WEBITGPT_SEED_DEMO_HOSTS=1.

INSPECTION_HOME=/opt/webitgpt
WEBITGPT_USER=sysinfra
WEBITGPT_GROUP=itagent

# Existing MongoDB. If MongoDB already exists on the new host, keep localhost.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=webitgpt

# Optional. Prefer entering this through INSTALL.sh so it is not saved in a file.
# WEBITGPT_SUPERADMIN_PASSWORD=change-this-before-login

# Production install should stay 0. Host records come from CSV import or IPAM scan.
WEBITGPT_SEED_DEMO_HOSTS=0
WEBITGPT_CLEANUP_TEST_DATA=0

# Optional first CMDB import file on the target host.
# WEBITGPT_INITIAL_HOSTS_CSV=/tmp/company_hosts.csv
